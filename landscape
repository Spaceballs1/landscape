```css
body {
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
  padding: 0;
  background: #f5f5f5;
  color: #333;
  line-height: 1.6;
}

header {
  background: #2c6e49;
  color: white;
  text-align: center;
  padding: 1rem;
}

nav a {
  color: white;
  margin: 0 10px;
  text-decoration: none;
  font-weight: 500;
}

nav a.active, nav a:hover {
  text-decoration: underline;
}

.hero {
  background: url('https://via.placeholder.com/1200x400') center/cover;
  color: white;
  text-align: center;
  padding: 4rem 1rem;
}

.hero h2 {
  font-size: 2rem;
}

.projects-preview, .projects-gallery, .content, .contact {
  padding: 2rem;
  text-align: center;
}

.gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  justify-content: center;
}

.gallery img {
  width: 300px;
  border-radius: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.2);
  transition: transform 0.3s ease;
}

.gallery img:hover {
  transform: scale(1.05);
}

footer {
  background: #2c6e49;
  color: white;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}

.phone-number {
  margin-top: 0.5rem;
  font-size: 1rem;
}

textarea {
  width: 80%;
  max-width: 500px;
  padding: 0.5rem;
  margin-top: 0.5rem;
}

button {
  padding: 0.5rem 1rem;
  background: #2c6e49;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.3s ease;
}

button:hover {
  background: #388e3c;
}

/* Animations */
.fade-in {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 1s forwards;
}

.slide-up {
  opacity: 0;
  transform: translateY(40px);
  animation: fadeInUp 1s forwards;
}

.slide-up.delay {
  animation-delay: 0.5s;
}

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
